NIYAM_ENVIRONMENT=local
NIYAM_LOG_LEVEL=INFO

# Model names change often. Check https://ai.google.dev/gemini-api/docs/models
NIYAM_LLM_PROVIDER=google_genai
NIYAM_LLM_MODEL=gemini-3.5-flash-lite
NIYAM_EMBEDDING_PROVIDER=google_genai
NIYAM_EMBEDDING_MODEL=gemini-embedding-001

# Get a key at https://aistudio.google.com and put it ONLY in your local .env
NIYAM_GOOGLE_API_KEY=replace-me

NIYAM_DB_USER=niyam
NIYAM_DB_PASSWORD=replace-me
NIYAM_DB_NAME=niyam
NIYAM_DB_PORT=5432
